# Démo locale = aucune connexion à un fournisseur IA, aucune facture API
MOCK_MODE=true
MISSION=Identifier, valider puis prototyper une opportunité d'activité rentable avec un budget limité.
DATABASE_URL=sqlite:///./data/company.db
MONTHLY_BUDGET_EUR=100
MAX_RUN_BUDGET_EUR=3
MAX_OUTPUT_TOKENS=500

# Mettre MOCK_MODE=false seulement APRÈS la configuration complète.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_MODEL=
GEMINI_MODEL=

# OBLIGATOIRE en mode réel : saisir les tarifs ACTUELS de chacun de VOS modèles
# en euros PAR MILLION de tokens. Pas de tarification implicite.
OPENAI_INPUT_EUR_PER_MTOK=
OPENAI_OUTPUT_EUR_PER_MTOK=
ANTHROPIC_INPUT_EUR_PER_MTOK=
ANTHROPIC_OUTPUT_EUR_PER_MTOK=
GEMINI_INPUT_EUR_PER_MTOK=
GEMINI_OUTPUT_EUR_PER_MTOK=

# Recherche web facultative (Tavily) ; facturation séparée
TAVILY_API_KEY=
TAVILY_COST_EUR_PER_SEARCH=

# Réglage de la tâche quotidienne, heure de Paris
TIMEZONE=Europe/Paris
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0

# Alternative avec PostgreSQL (voir docker-compose.yml)
# POSTGRES_PASSWORD=change_this_local_password
# DATABASE_URL=postgresql+psycopg://company:change_this_local_password@127.0.0.1:5432/company

# Lot 3 : tests isolés dans Docker (désactivés tant que vide).
# Identifiant IMMUABLE de l'image autorisée, après pull et vérification manuelle :
#   docker pull python:3.12-slim && docker image inspect --format '{{.Id}}' python:3.12-slim
SANDBOX_PYTHON_IMAGE_ID=
# Répertoire hôte des espaces de travail temporaires (défaut : /tmp/aac-sandbox)
# SANDBOX_WORKDIR=
